# Local dev: leave TURSO_* unset — the app falls back to an embedded local
# SQLite file at backend/data/expenses.db, no Turso account needed.
#
# Production (Render): set these to your Turso database's credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signs login sessions. Required in production — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local dev falls back to an insecure default if unset (fine for local only).
JWT_SECRET=

# Encrypts sensitive fields at rest (account/category names, expense
# descriptions, amounts, income sources) — see src/lib/crypto.js. Required in
# production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: once real data has been encrypted with a key, changing that key
# makes the old data unreadable (it won't crash — decrypt() falls back to
# returning garbled ciphertext instead of the real value). Set this once and
# don't rotate it casually.
ENCRYPTION_KEY=

# Comma-free single origin of your deployed frontend, e.g. https://your-app.vercel.app
# Leave unset to allow any origin (fine temporarily, but set this in production).
FRONTEND_ORIGIN=

# Render sets PORT automatically; only needed for local overrides.
PORT=3001
